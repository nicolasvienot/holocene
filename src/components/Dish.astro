---
import Tag from './Tag.astro';

interface Props {
  name: string;
  description: string;
  tags?: ('sg' | 'vege')[];
  /** Supplément en euros. */
  supplement?: number;
}

const { name, description, tags = [], supplement } = Astro.props;
const tagLabels = { sg: 'SG', vege: 'Végé' };
---

<div class="dish">
  <div class="dish__head">
    <span class="dish__name">{name}</span>
    {tags.map((tag) => <Tag tone="white">{tagLabels[tag]}</Tag>)}
    {supplement !== undefined && <Tag>{`+${supplement} €`}</Tag>}
  </div>
  <p class="dish__description">{description}</p>
</div>

<style>
  .dish {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block: 16px;
    border-bottom: var(--line-dashed);
  }

  /* Pas de trait après le dernier plat. */
  .dish:last-child {
    border-bottom: 0;
  }

  .dish__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .dish__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .dish__description {
    font-size: 15px;
    line-height: 1.5;
  }
</style>
