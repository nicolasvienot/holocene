---
import Kicker from './Kicker.astro';

interface Props {
  label: string;
  telephone: { affiche: string; tel: string };
}

const { label, telephone } = Astro.props;
---
<div class="tel">
  <Kicker texte={label} />
  <a href={`tel:${telephone.tel}`} class="d">{telephone.affiche}</a>
</div>

<style>
  .tel { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 2px dashed var(--ink); border-radius: var(--radius-sm); }
  a { font-size: 32px; text-decoration: none; }
  a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 4px; }
</style>
