---
interface Props {
  text: string;
  size?: 'sm' | 'md' | 'lg';
  as?: 'span' | 'p' | 'div';
}

const { text, size = 'md', as: Tag = 'span' } = Astro.props;

// Vividly n'a que ces glyphes (voir CLAUDE.md). Le rendu étant statique, ce code ne tourne
// que côté serveur : l'avertissement apparaît en dev et dans les logs de `astro build`.
const missing = [...new Set(text.toUpperCase().match(/[^ABCDEFGILMNOPRSTUX ]/g) ?? [])];
if (missing.length > 0) {
  console.warn(`[Accent] « ${text} » : glyphes absents de Vividly : ${missing.join(' ')}`);
}
---

<Tag class:list={['accent', `accent--${size}`]}>{text}</Tag>

<style>
  .accent {
    display: block;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .accent--sm {
    font-size: 22px;
  }

  .accent--md {
    font-size: 30px;
  }

  .accent--lg {
    font-size: 38px;
  }

  @media (max-width: 760px) {
    .accent--md {
      font-size: 22px;
    }

    .accent--lg {
      font-size: 26px;
    }
  }
</style>
