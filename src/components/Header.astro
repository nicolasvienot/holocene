---
import Button from './Button.astro';
import Icon from './Icon.astro';
import infos from '../data/infos.json';
import { capsules, univers as tousLesUnivers, universParId, type CapsuleId } from '../data/navigation';
import { attrsExterne } from '../lib/texte';

interface Props {
  capsule: CapsuleId;
  /** Lien de la capsule marqué comme page active */
  actif?: string;
}

const { capsule, actif } = Astro.props;
const { univers, aria, liens, cta } = capsules[capsule];
const courant = universParId(univers);
const tel = univers === 'restaurant' ? infos.telephones.restaurant : infos.telephones.traiteurFoodTruck;
---
<header class="wrap capw">
  <div class="cap">
    <a href={courant.href} class="clogo"><img src={courant.logo} alt={courant.logoAlt} width="156" height="40" /></a>

    <nav aria-label={aria} class="cnav">
      {liens.map((lien) => (
        <a href={lien.href} class:list={['cn', { on: lien.label === actif }]} aria-current={lien.label === actif ? 'page' : undefined}>{lien.label}</a>
      ))}
    </nav>

    <div class="cend">
      <div class="unis" role="group" aria-label="Changer d'univers">
        {tousLesUnivers.map((u) => (
          <a
            href={u.href}
            class:list={['ud', { on: u.id === univers }]}
            style={`background:${u.fond}`}
            aria-label={u.id === univers ? `${u.label}, univers actuel` : u.label}
            aria-current={u.id === univers ? 'true' : undefined}
          ><span class="tip" aria-hidden="true">{u.label}</span></a>
        ))}
      </div>
      <Button variant="dark" href={cta.href} label={cta.label} />
    </div>

    <details class="cmenu" data-menu>
      <summary aria-label="Menu">
        <Icon name="burger" size={20} class="ico-b" />
        <Icon name="close" size={20} class="ico-x" />
      </summary>
      <div class="cpanel">
        {liens.map((lien) => (
          <a href={lien.href} class:list={['cbig', { on: lien.label === actif }]} aria-current={lien.label === actif ? 'page' : undefined} {...attrsExterne(lien.href)}>{lien.label}</a>
        ))}
        <span class="clab">Nos univers</span>
        <div class="cunis">
          {tousLesUnivers.map((u) => (
            <a href={u.href} class:list={['cuni', { on: u.id === univers }]} style={`background:${u.fond}`} aria-current={u.id === univers ? 'true' : undefined}>{u.label}</a>
          ))}
        </div>
        <Button variant="dark" href={cta.href} label={cta.label} class="cbtn" />
        <a href={`tel:${tel.tel}`} class="ctel">{tel.affiche}</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Le menu fonctionne sans script ; ceci le referme après un clic sur une ancre ou avec Échap.
  document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
    menu.addEventListener('click', (evenement) => {
      if (evenement.target instanceof Element && evenement.target.closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .capw { position: relative; z-index: 40; padding-block: 18px; }

  .cap {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 24px;
    min-height: 68px;
    padding: 8px 8px 8px 24px;
    background: var(--paper);
    border: var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn);
    color: var(--ink);
    --focus: var(--ink);
  }

  .clogo { display: flex; }
  .clogo img { height: 40px; width: auto; display: block; }

  .cnav { display: flex; justify-content: center; gap: 24px; }

  .cn {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0 0 0.12em;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .cn::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 3px;
    border-radius: 3px;
    background: var(--ink);
    transform: scaleX(0);
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .cn:hover::after,
  .cn.on::after { transform: scaleX(1); }

  .cend { display: flex; align-items: center; gap: 16px; }
  .unis { display: flex; align-items: center; gap: 8px; padding-right: 16px; border-right: var(--line); }

  .ud {
    position: relative;
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: var(--line);
    transition: transform 0.15s;
  }
  /* Cible tactile de 44 px autour de la pastille de 28 px */
  .ud::before { content: ''; position: absolute; inset: -10px -6px; }
  .ud:hover { transform: translateY(-2px); }
  .ud.on { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5px var(--ink); }

  .tip {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 10px 6px calc(10px + 0.12em);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .ud:hover .tip,
  .ud:focus-visible .tip { opacity: 1; }

  .cmenu { display: none; border: 0; }
  .cmenu summary {
    list-style: none;
    width: 50px;
    height: 50px;
    border: var(--line);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--flower);
    color: var(--ink);
    transition: transform 0.15s;
  }
  .cmenu summary::-webkit-details-marker { display: none; }
  .cmenu summary:hover { transform: scale(1.06); }
  .cmenu :global(.ico-x) { display: none; }
  .cmenu[open] summary { background: var(--ink); color: var(--paper); }
  .cmenu[open] :global(.ico-b) { display: none; }
  .cmenu[open] :global(.ico-x) { display: block; }

  .cpanel {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 12px);
    display: flex;
    flex-direction: column;
    padding: 8px 22px 22px;
    background: var(--paper);
    border: var(--line);
    border-radius: 28px;
    box-shadow: var(--shadow-btn);
  }

  .cbig {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 6px 0;
    border-bottom: var(--line-dashed);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .cbig:last-of-type { border-bottom: 0; }
  .cbig.on { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }

  .clab {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 10px;
    color: var(--muted);
  }

  .cunis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }

  .cuni {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px 0 calc(12px + 0.12em);
    border: var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 11px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .cuni.on { background: var(--ink) !important; color: var(--paper); }

  .cbtn { margin-top: 18px; width: 100%; }

  .ctel {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink);
    text-align: center;
  }

  @media (max-width: 1320px) {
    .cap { grid-template-columns: 1fr auto; padding: 6px 6px 6px 22px; }
    .cnav,
    .cend { display: none; }
    .cmenu { display: block; }
  }

  @media (max-width: 760px) {
    .capw { padding-block: 12px; }
    .clogo img { height: 34px; }
    .cap { min-height: 60px; }
  }
</style>
