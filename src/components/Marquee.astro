---
import Accent from './Accent.astro';

interface Props {
  /** Mots en Vividly : uniquement les lettres autorisées. */
  items: string[];
  /** dark : bandeau noir, séparateur icône. flower : bandeau fleur, séparateur point. */
  tone?: 'dark' | 'flower';
}

const { items, tone = 'dark' } = Astro.props;
// Deux copies identiques : la boucle se raccorde à -50 %.
const copies = [0, 1];
---

<div aria-hidden="true" class:list={['marquee', `marquee--${tone}`]}>
  <div class="marquee__track">
    {
      copies.map(() => (
        <div class="marquee__group">
          {items.map((item) => (
            <>
              <Accent text={item} size="lg" />
              {tone === 'dark' ? (
                <img src="/brand/icon-white.svg" alt="" width="20" height="40" loading="lazy" />
              ) : (
                <span class="marquee__dot" />
              )}
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 22px;
    border-block: var(--line);
  }

  .marquee--dark {
    background: var(--ink);
    color: var(--paper);
  }

  .marquee--flower {
    background: var(--flower);
    color: var(--ink);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
  }

  .marquee__group img {
    width: auto;
    height: 40px;
  }

  .marquee__group :global(.accent) {
    white-space: nowrap;
  }

  .marquee__dot {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ink);
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 760px) {
    .marquee {
      padding-block: 16px;
    }

    .marquee__group {
      gap: 22px;
      padding-right: 22px;
    }

    .marquee__group img {
      height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
