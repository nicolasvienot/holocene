---
import Accent from './Accent.astro';

interface Props {
  /** Une entrée par ligne. */
  title: string | string[];
  level?: 1 | 2 | 3;
  /** Une ligne en Vividly au-dessus du titre. */
  accent?: string;
  /** Un label Nimbus au-dessus du titre. */
  label?: string;
}

const { title, level = 2, accent, label } = Astro.props;
const lines = Array.isArray(title) ? title : [title];
const Heading = `h${level}` as 'h1' | 'h2' | 'h3';
---

<div class="section-header">
  <div class="section-header__title">
    {accent && <Accent text={accent} />}
    {label && <span class="label">{label}</span>}
    <Heading class="display section-header__heading">
      {lines.map((line, index) => (index === 0 ? line : <><br />{line}</>))}
    </Heading>
  </div>
  {Astro.slots.has('default') && <p class="section-header__text"><slot /></p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 64px;
    margin-bottom: 48px;
  }

  .section-header__title {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-header__heading {
    font-size: clamp(42px, 6vw, 92px);
  }

  .section-header__text {
    flex: 0 1 420px;
    text-wrap: pretty;
  }
</style>
