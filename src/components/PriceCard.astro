---
import Card from './Card.astro';
import Tag from './Tag.astro';

interface Props {
  /** Le prix est le titre de la carte : 60 px maximum. */
  price: string;
  label: string;
  note?: string;
  /** Fond fleur et ombre 10 px : une seule carte par rangée. */
  highlight?: boolean;
  /** Étiquette en haut à droite, ex. « Le plus pris ». */
  badge?: string;
}

const { price, label, note, highlight = false, badge } = Astro.props;
---

<Card tone={highlight ? 'flower' : 'paper'} highlight={highlight} class="price">
  <div class="price__top">
    <span class="label">{label}</span>
    {badge && <Tag tone="white">{badge}</Tag>}
  </div>
  <div class="price__bottom">
    <p class="display price__value">{price}</p>
    {note && <p class="price__note">{note}</p>}
  </div>
</Card>

<style>
  :global(.card).price {
    justify-content: space-between;
    gap: 32px;
    min-height: 230px;
  }

  .price__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .price__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .price__value {
    font-size: clamp(56px, 5vw, 60px);
  }

  .price__note {
    font-size: 15px;
  }
</style>
