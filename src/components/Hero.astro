---
import Accent from './Accent.astro';

interface Props {
  /** Une entrée par ligne. */
  title: string | string[];
  accent?: string;
  /** Phrase d'accroche (20 px). */
  text?: string;
  /** Héros noir, texte blanc. */
  dark?: boolean;
  /** Échelle du titre : à choisir selon le mot le plus long, pour tenir à 390 px. */
  size?: 'xl' | 'lg' | 'md' | 'sm';
  /** split : titre et texte à gauche, visuel à droite. stacked : titre pleine largeur au-dessus. */
  layout?: 'split' | 'stacked';
  /** h1 par défaut ; h2 ou h3 pour une démonstration (design system). */
  level?: 1 | 2 | 3;
}

const { title, accent, text, dark = false, size = 'lg', layout = 'split', level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3';
const lines = Array.isArray(title) ? title : [title];
const hasVisual = Astro.slots.has('visual');
const hasActions = Astro.slots.has('actions');
---

<section class:list={['hero', { 'hero--dark': dark }]} data-on-dark={dark ? '' : undefined}>
  <div class:list={['wrap', 'hero__inner', `hero__inner--${layout}`, { 'hero__inner--visual': hasVisual }]}>
    <div class="hero__head">
      {accent && <Accent text={accent} />}
      <Heading class:list={['display', 'hero__title', `hero__title--${size}`]}>
        {lines.map((line, index) => (index === 0 ? line : <><br />{line}</>))}
      </Heading>
    </div>
    <div class="hero__body">
      {text && <p class="hero__text">{text}</p>}
      {hasActions && <div class="actions"><slot name="actions" /></div>}
    </div>
    {hasVisual && <div class="hero__visual"><slot name="visual" /></div>}
  </div>
</section>

<style>
  .hero--dark {
    background: var(--ink);
    color: var(--paper);
  }

  .hero--dark :global(.accent) {
    color: var(--flower);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
    padding-block: 36px 64px;
  }

  .hero--dark .hero__inner {
    padding-top: 64px;
  }

  .hero__head,
  .hero__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }

  .hero__title--xl {
    font-size: clamp(60px, 9.4vw, 148px);
  }

  .hero__title--lg {
    font-size: clamp(56px, 7.8vw, 112px);
  }

  .hero__title--md {
    font-size: clamp(52px, 7vw, 102px);
  }

  /* Pour les mots très longs (BISTRONOMIQUE) : suit la largeur d'écran en mobile. */
  .hero__title--sm {
    font-size: clamp(36px, 8.4vw, 132px);
  }

  .hero__text {
    max-width: 540px;
    font-size: 20px;
    text-wrap: pretty;
  }

  .hero--dark .hero__text {
    color: var(--text-on-dark-muted);
  }

  .hero__visual {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hero__inner--visual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
    }

    .hero__inner--split.hero__inner--visual {
      grid-template-rows: auto auto;
      align-content: center;
      align-items: center;
    }

    .hero__inner--split .hero__head {
      align-self: end;
    }

    .hero__inner--split .hero__body {
      align-self: start;
    }

    .hero__inner--split .hero__visual {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .hero__inner--stacked.hero__inner--visual {
      row-gap: 56px;
      align-items: start;
    }

    .hero__inner--stacked .hero__head {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    /* Le mot le plus long courant (ÉVÉNEMENT., PERSONNES,) fait ~5,9 em : il doit tenir dans la colonne. */
    .hero__title--xl,
    .hero__title--lg,
    .hero__title--md {
      font-size: min(60px, calc((100vw - 2 * var(--gutter)) / 6));
    }

    .hero__inner,
    .hero__head,
    .hero__body {
      gap: 22px;
    }

    .hero__inner {
      padding-block: 20px 40px;
    }

    .hero--dark .hero__inner {
      padding-top: 40px;
    }

    .hero__text {
      font-size: 16px;
    }
  }
</style>
