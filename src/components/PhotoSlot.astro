---
import { univers as allUnivers, type UniversId } from '../data/univers';

interface Props {
  /** Ce que montrera la photo : affiché après « Photo - ». */
  label?: string;
  /** Vraie photo : remplace l'emplacement. `alt` devient obligatoire. */
  src?: string;
  alt?: string;
  ratio?: '5/4' | '4/5' | '1/1';
  /** Donne l'icône et les couleurs de l'emplacement. */
  univers?: UniversId;
  /** flower : fleur de l'univers. bg : son fond. dark : sur héros noir. */
  tone?: 'flower' | 'bg' | 'dark';
  /** Ombre 10 px : la photo principale de la page. */
  highlight?: boolean;
  /** Sans contour ni rayon, à bord perdu dans une carte. */
  flush?: boolean;
}

const { label, src, alt = '', ratio = '5/4', univers = 'holocene', tone = 'flower', highlight = false, flush = false } = Astro.props;
const icon = tone === 'dark' ? '/brand/icon-white.svg' : allUnivers[univers].icon;
---

<!-- Les autocollants passent dans le slot : ils débordent du cadre, donc pas d'overflow ici. -->
<div
  data-univers={univers}
  class:list={['slot', `slot--${tone}`, { 'slot--photo': src, 'slot--highlight': highlight, 'slot--flush': flush }]}
  style={`aspect-ratio: ${ratio.replace('/', ' / ')}`}
>
  {
    src ? (
      <img class="slot__photo" src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <>
        <img class="slot__icon" src={icon} alt="" width="75" height="150" loading="lazy" />
        <span class="label">Photo - {label}</span>
      </>
    )
  }
  <slot />
</div>

<style>
  .slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: 100%;
    padding: 16px;
    border: var(--line);
    border-radius: var(--radius-card);
    color: var(--ink);
    text-align: center;
  }

  .slot__icon {
    width: auto;
    height: min(150px, 45%);
  }

  .slot--flower {
    background: var(--flower);
  }

  .slot--bg {
    background: var(--bg);
  }

  .slot--dark {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--paper);
  }

  .slot--photo {
    padding: 0;
  }

  .slot__photo {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-card) - 2px);
    object-fit: cover;
  }

  .slot--highlight {
    box-shadow: var(--shadow-hero);
  }

  .slot--dark.slot--highlight {
    box-shadow: 10px 10px 0 var(--paper);
  }

  .slot--flush {
    border-width: 0 0 2px;
    border-radius: 0;
  }

  @media (max-width: 760px) {
    .slot--highlight {
      box-shadow: var(--shadow-hover);
    }

    .slot--dark.slot--highlight {
      box-shadow: 6px 6px 0 var(--paper);
    }
  }
</style>
