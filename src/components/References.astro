---
import data from '../data/references.json';

interface Props {
  page: keyof typeof data.ordre;
  /** 3 colonnes, à côté du témoignage (Traiteur) */
  troisColonnes?: boolean;
}

const { page, troisColonnes = false } = Astro.props;
const tuiles = data.ordre[page].map((nom) => {
  const ref = data.references.find((r) => r.nom === nom);
  if (!ref) throw new Error(`Référence inconnue dans references.json : ${nom}`);
  return ref;
});
---
<ul class:list={['refs', { r3: troisColonnes }]}>
  {tuiles.map((ref) => (
    <li class="ref"><span class="k">{ref.categorie}</span><b>{ref.nom}</b></li>
  ))}
</ul>

<style>
  .refs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .refs.r3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .ref {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 128px;
    padding: 20px 22px 22px;
    background: var(--paper);
    border: var(--line);
    border-radius: 18px;
    min-width: 0;
  }
  .k { font-size: 10px; letter-spacing: 0.18em; opacity: 0.55; }
  b {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 20px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1100px) {
    .refs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .refs,
    .refs.r3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ref { min-height: 108px; padding: 16px 16px 18px; }
    b { font-size: 17px; }
  }
</style>
