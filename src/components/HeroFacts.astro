---
import type { HeroFact } from '../types';

interface Props {
  faits: HeroFact[];
}

const { faits } = Astro.props;
const COURT = 13; // au-delà, la valeur passe en texte courant
---
<dl class="facts">
  {faits.map((fait) => (
    <div class="fact">
      <dt class="k">{fait.label}</dt>
      <dd class:list={fait.valeur.length <= COURT ? 'd val' : 'txt'}>{fait.valeur}</dd>
    </div>
  ))}
</dl>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 0;
    width: 100%;
    max-width: 540px;
    margin: 6px 0 0;
    padding-top: 20px;
    border-top: 2px solid currentColor;
  }
  .fact { display: flex; flex-direction: column; gap: 8px; padding-right: 28px; }
  .fact + .fact { padding-right: 0; padding-left: 28px; border-left: 2px solid currentColor; }
  .k { font-size: 10px; }
  dd { margin: 0; }
  .val { font-size: 24px; line-height: 1; }
  .txt { font-size: 17px; line-height: 1.3; }
</style>
