---
interface Props {
  /** Cible d'ancre de la navigation. */
  id: string;
  /** Nom de la section à construire. */
  name: string;
}

const { id, name } = Astro.props;
---

<section {id} class="wrap stub">
  <p>[Section à venir : {name}]</p>
</section>

<style>
  .stub {
    padding-block: 32px;
    font-size: 15px;
  }
</style>
