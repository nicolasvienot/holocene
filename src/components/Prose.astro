---
<div class="prose"><slot /></div>

<style>
  .prose { max-width: 68ch; font-size: 18px; line-height: 1.6; }
  @media (max-width: 760px) {
    .prose { font-size: 16px; }
  }
  .prose :global(h2) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.2;
    margin: 56px 0 16px;
  }
  .prose :global(h3) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.3;
    margin: 36px 0 10px;
  }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul) { margin: 0 0 18px; padding: 0; }
  .prose :global(li) { padding: 12px 0; border-bottom: var(--line-dashed); }
  .prose :global(li:last-child) { border-bottom: 0; }
  .prose :global(> :first-child) { margin-top: 0; }
</style>
