---
interface Props {
  tone?: 'outline' | 'white' | 'flower' | 'dark';
  /** Grande pastille (18 px), pour un mur de références. */
  size?: 'md' | 'lg';
  /**
   * Autocollant incliné, à cheval sur le bord d'un visuel (15 px).
   * -8 : en haut à gauche ; 6 : en bas à droite. Deux maximum par visuel.
   */
  sticker?: -8 | 6;
  class?: string;
}

const { tone = 'outline', size = 'md', sticker, class: className, ...rest } = Astro.props;
---

<span
  {...rest}
  class:list={[
    'pill',
    `pill--${tone}`,
    `pill--${size}`,
    sticker === -8 && 'pill--sticker-a',
    sticker === 6 && 'pill--sticker-b',
    className,
  ]}
>
  <slot />
</span>

<style>
  .pill {
    --pad-y: 8px;
    --pad-x: 16px;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: var(--pad-y) var(--pad-x) var(--pad-y) calc(var(--pad-x) + 0.14em);
    border: var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pill--lg {
    --pad-y: 16px;
    --pad-x: 26px;
    font-size: 18px;
  }

  .pill--white {
    background: var(--paper);
    color: var(--ink);
  }

  .pill--flower {
    background: var(--flower);
    color: var(--ink);
  }

  .pill--dark {
    background: var(--ink);
    color: var(--paper);
  }

  /* Contour : hérite du texte. Sur noir, il passe donc en blanc. */
  .pill--outline {
    border-color: currentColor;
  }

  .pill--sticker-a,
  .pill--sticker-b {
    --pad-y: 12px;
    --pad-x: 20px;
    position: absolute;
    z-index: 1;
    font-size: 15px;
  }

  .pill--sticker-a {
    top: 24px;
    left: -14px;
    transform: rotate(-8deg);
  }

  .pill--sticker-b {
    right: -12px;
    bottom: 24px;
    transform: rotate(6deg);
  }

  @media (max-width: 760px) {
    .pill--sticker-a {
      left: -8px;
    }

    .pill--sticker-b {
      right: -8px;
    }
  }
</style>
