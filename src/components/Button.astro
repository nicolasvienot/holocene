---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';
import { attrsExterne, nimbus } from '../lib/texte';

type Variant = 'dark' | 'light' | 'flower' | 'onDark' | 'onDarkFlower';

interface Props extends Omit<HTMLAttributes<'a'>, 'type' | 'href'> {
  variant?: Variant;
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  icon?: Extract<IconName, 'arrow' | 'download' | 'external'>;
  /** Bouton inactif, ou emplacement en attente d'un fichier. */
  disabled?: boolean;
  label?: string;
}

const { variant = 'light', size = 'md', href, type, icon, disabled = false, label, class: className, ...rest } = Astro.props;

// Sans href ni type : un simple <span>, pour un bouton posé dans une carte déjà cliquable.
const Tag = disabled ? 'span' : href ? 'a' : type ? 'button' : 'span';
const liens = Tag === 'a' && href ? { href, ...attrsExterne(href) } : {};
const typeBouton = Tag === 'button' ? { type } : {};
const contenu = label ? nimbus(label) : undefined;
---
<Tag
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', disabled && 'btn--off', className]}
  aria-disabled={disabled ? 'true' : undefined}
  {...liens}
  {...typeBouton}
  {...rest}
>{contenu}<slot />{icon && <Icon name={icon} size={icon === 'external' ? 14 : icon === 'download' ? 16 : 18} />}</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px 0 calc(26px + 0.12em);
    border: var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 13px;
    max-width: 100%;
    padding-block: 6px;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--btn-ombre, var(--ink));
    transition: transform 0.15s, box-shadow 0.15s, background-color 0.15s, color 0.15s;
  }

  .btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--btn-ombre, var(--ink));
  }

  .btn:focus-visible { outline: 3px solid var(--focus, var(--ink)); outline-offset: 3px; }

  .btn--flower { background: var(--flower); }

  .btn--dark { background: var(--ink); color: var(--paper); box-shadow: none; }
  .btn--dark:hover { background: var(--paper); color: var(--ink); box-shadow: none; transform: none; }
  .btn--dark:active { transform: scale(0.96); }

  .btn--onDark,
  .btn--onDarkFlower { --focus: var(--paper); border-color: var(--paper); box-shadow: 4px 4px 0 var(--paper); }
  .btn--onDark:hover,
  .btn--onDarkFlower:hover { box-shadow: 2px 2px 0 var(--paper); }
  .btn--onDarkFlower { background: var(--flower); }

  .btn--sm { min-height: 44px; padding: 0 18px 0 calc(18px + 0.12em); font-size: 12px; box-shadow: 3px 3px 0 var(--ink); }

  .btn--off,
  .btn--off:hover {
    background: var(--disabled-bg);
    color: var(--disabled-fg);
    border-color: var(--disabled-line);
    box-shadow: none;
    transform: none;
    cursor: not-allowed;
  }
</style>
