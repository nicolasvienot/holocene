---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Pill from '../components/Pill.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';
import type { UniversId } from '../data/univers';
import Base from '../layouts/Base.astro';

const founders: { firstName: string; name: string; pole: string; univers: UniversId; text: string }[] = [
  {
    firstName: 'Julien',
    name: 'Julien Sanchez',
    pole: 'Pôle cuisine',
    univers: 'restaurant',
    text: "Le chef. Passé par L'Allée des Vignes à Cajarc, maison étoilée, il signe toutes les cartes et met les saveurs régionales au centre de l'assiette.",
  },
  {
    firstName: 'Théo',
    name: 'Théo Constant',
    pole: 'Pôle organisation',
    univers: 'traiteur',
    text: "L'homme du jour J. Après avoir dirigé des restaurants à Toulouse, il orchestre la salle, le service et la logistique de chaque événement.",
  },
  {
    firstName: 'Stéphane',
    name: 'Stéphane Suarez',
    pole: 'Pôle commercial',
    univers: 'food-truck',
    text: "Votre premier contact. Il a roulé sa bosse sur six continents et suit chaque projet du premier appel jusqu'au jour J.",
  },
];
---

<Base
  title="L'équipe"
  description="Théo, Stéphane et Julien se sont rencontrés à l'école hôtelière. Aujourd'hui, une équipe de 24 personnes entre Balma, Toulouse et l'Occitanie."
>
  <Hero
    accent="Trois potes"
    size="xl"
    layout="stacked"
    title={['24 personnes,', 'une seule envie.']}
    text="Théo, Stéphane et Julien se sont rencontrés à l'école hôtelière. Chacun est parti apprendre de son côté (maisons étoilées, voyages, salles toulousaines) avant de revenir avec la même idée : ouvrir l'endroit où ils auraient aimé manger."
  >
    <Fragment slot="actions">
      <Button href="/contact" variant="primary">Demander un devis</Button>
      <Button href={site.zenchef.table} external>Réserver une table</Button>
    </Fragment>
    <PhotoSlot slot="visual" label="Les 3 associés au comptoir" highlight />
  </Hero>

  <section class="founders">
    <div class="wrap section">
      <SectionHeader title="Les fondateurs" />
      <div class="cards">
        {
          founders.map((founder) => (
            <Card flush>
              <PhotoSlot label={founder.firstName} ratio="1/1" univers={founder.univers} tone="bg" flush />
              <div class="founder" data-univers={founder.univers}>
                <Pill tone="flower">{founder.pole}</Pill>
                <h3 class="display founder__name">{founder.name}</h3>
                <p class="founder__text">{founder.text}</p>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .founders {
    background: var(--flower);
    border-block: var(--line);
  }

  .founder {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }

  .founder__name {
    font-size: 36px;
  }

  .founder__text {
    font-size: 16px;
  }
</style>
