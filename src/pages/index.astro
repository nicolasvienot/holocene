---
import Accent from '../components/Accent.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Pill from '../components/Pill.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';
import { chronology, univers } from '../data/univers';
import Base from '../layouts/Base.astro';

const cardContent = {
  'food-truck': {
    pill: 'Le tout premier',
    text: "Pains gourmands sur ciabatta, produits d'Occitanie, cuisinés en live sur vos festivals, mariages et soirées.",
  },
  traiteur: {
    pill: 'Sur mesure',
    text: 'Cocktails, repas assis, mariages, box : une cuisine de chef pour vos événements, de 40 à 1500 invités.',
  },
  restaurant: {
    pill: 'Lun - Ven midi',
    text: 'Notre cantine bistronomique à Balma : carte du mois, vins nature, bières craft et une grande terrasse.',
  },
};

const values = [
  { accent: 'Local', text: "En direct avec les producteurs d'Occitanie, sans intermédiaire. On connaît le nom de celui qui a fait le jambon." },
  { accent: 'De saison', text: 'Des cartes qui bougent avec le marché : nouvelle carte chaque mois au restaurant, suggestions chaque semaine.' },
  { accent: 'Fait maison', text: 'Tout sort de nos cuisines, des sauces aux desserts. Même le thé glacé et la citronnade.' },
  { accent: 'Sur mesure', text: "Thème, budget, régimes : végétarien, halal, sans gluten. On s'adapte à votre événement, pas l'inverse." },
];
---

<Base
  title="Restaurant, traiteur et food truck à Balma"
  description="Un restaurant, un traiteur, un food truck : trois façons de manger local, de saison et fait maison, à Balma, Toulouse et partout en Occitanie."
>
  <Hero
    accent="Des produits frais"
    size="xl"
    title={['On cuisine', 'le vivant.']}
    text="Un restaurant, un traiteur, un food truck. Trois façons de manger local, de saison et 100 % fait maison, imaginées par trois potes d'école hôtelière et une équipe de 24 passionnés."
  >
    <Fragment slot="actions">
      <Button href="/contact" variant="primary" icon="arrow">Demander un devis</Button>
      <Button href={site.zenchef.table} external>Réserver une table</Button>
    </Fragment>
    <PhotoSlot
      slot="visual"
      src="/images/verrines-full.jpg"
      alt="Verrines de gaspacho et bouchées petits pois et foie gras dressées par Holocene Traiteur"
      highlight
    >
      <Pill tone="white" sticker={-8}>Frais</Pill>
      <Pill tone="flower" sticker={6}>Local</Pill>
    </PhotoSlot>
  </Hero>

  <Marquee items={['Fait maison', 'De saison', 'Local', 'Frais', 'Sur mesure']} />

  <section class="wrap section">
    <SectionHeader label="Food truck - Traiteur - Restaurant" title={['Une maison.', 'Trois univers.']}>
      Tout a commencé avec le food truck. Sa fleur pêche est devenue la couleur du traiteur, dont la fleur jaune colore
      aujourd'hui le restaurant. Une même famille, trois personnalités.
    </SectionHeader>
    <div class="cards">
      {
        chronology.map((id, index) => (
          <Card href={univers[id].home} tone="bg" data-univers={id} class="univers-card">
            <div class="univers-card__top">
              <span class="display univers-card__number">{String(index + 1).padStart(2, '0')}</span>
              <Pill tone="white">{cardContent[id as keyof typeof cardContent].pill}</Pill>
            </div>
            <img class="univers-card__icon" src={univers[id].icon} alt="" width="75" height="150" loading="lazy" />
            <div class="univers-card__body">
              <img class="univers-card__logo" src={univers[id].logo} alt={univers[id].fullName} width="1470" height="378" loading="lazy" />
              <p>{cardContent[id as keyof typeof cardContent].text}</p>
              <Button decorative>Découvrir</Button>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="wrap section values">
    <SectionHeader title="Ce qu'on ne lâche jamais" />
    <div class="cards" style="--min: 270px">
      {
        values.map((value, index) => (
          <Card tone={index === values.length - 1 ? 'dark' : 'paper'}>
            <Accent text={value.accent} size="lg" />
            <p class="value__text">{value.text}</p>
          </Card>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .cards :global(.univers-card) {
    justify-content: space-between;
    gap: 32px;
    min-height: 560px;
  }

  .univers-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .univers-card__number {
    font-size: 44px;
  }

  .univers-card__icon {
    align-self: center;
    width: auto;
    height: 170px;
  }

  .univers-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    font-size: 16px;
  }

  .univers-card__logo {
    width: 100%;
    max-width: 280px;
  }

  .values {
    padding-top: 0;
  }

  .value__text {
    font-size: 16px;
  }

  @media (max-width: 760px) {
    .cards :global(.univers-card) {
      min-height: 0;
      gap: 22px;
    }

    .univers-card__icon {
      height: 120px;
    }
  }
</style>
