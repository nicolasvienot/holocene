---
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Dish from '../../components/Dish.astro';
import Faq from '../../components/Faq.astro';
import Hero from '../../components/Hero.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import Pill from '../../components/Pill.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SectionStub from '../../components/SectionStub.astro';
import { phones, site } from '../../data/site';
import Base from '../../layouts/Base.astro';

const faq = [
  { question: 'Faut-il réserver ?', answer: `C'est conseillé, surtout en fin de semaine. Réservez en ligne, au ${phones.restaurant.display} ou en passant au restaurant.` },
  { question: 'Ouvrez-vous le soir et le week-end ?', answer: 'Le service régulier a lieu en semaine, le midi. Les soirs et week-ends, le lieu se privatise pour vos événements.' },
  { question: 'Avez-vous des plats végétariens et sans gluten ?', answer: 'Oui, ils sont signalés sur la carte, et une carte des allergènes est disponible sur demande.' },
];
---

<Base
  title="Restaurant bistronomique à Balma"
  description="La cantine bistronomique de Balma : une carte qui change chaque mois, ouverte du lundi au vendredi de 12h à 14h."
  univers="restaurant"
>
  <Hero
    accent="Le midi en semaine"
    size="sm"
    layout="stacked"
    title={['La cantine', 'bistronomique', 'de Balma.']}
    text="Une carte qui change chaque mois, des suggestions chaque semaine, des produits qui arrivent en direct des fermes d'Occitanie. Le tout cuisiné sous vos yeux par le chef Julien Sanchez et sa brigade."
  >
    <Fragment slot="actions">
      <Button href={site.zenchef.table} external variant="primary">Réserver une table</Button>
      <Button href="#carte" variant="flower">Voir la carte</Button>
    </Fragment>
    <PhotoSlot slot="visual" label="Gnocchi aux champignons" univers="restaurant" highlight>
      <Pill tone="white" sticker={-8}>Carte du mois</Pill>
      <Pill tone="white" sticker={6}>{site.hours.short}</Pill>
    </PhotoSlot>
  </Hero>

  <section id="carte" class="carte">
    <div class="wrap section">
      <SectionHeader accent="La carte du moment" title="Les formules">
        Prix TTC, service compris. Suggestion du jour à l'ardoise pour l'entrée, le plat et le dessert.
      </SectionHeader>
      <div class="cards" style="--min: 280px">
        <PriceCard label="Plat" price="17€" />
        <PriceCard label="Entrée - plat ou plat - dessert" price="20,50€" />
        <PriceCard label="Entrée - plat - dessert" price="24€" highlight badge="Le plus pris" />
      </div>

      <div class="dishes">
        <h3 class="display dishes__title">Les plats</h3>
        <div>
          <Dish name="Tartare de poisson" description="pomme Granny, aneth, concombre, jus vert et moutarde nori" tags={['sg']} supplement={1} />
          <Dish name="Cromesquis de poulet" description="sauce spicy et salade fraîcheur" tags={['sg']} />
          <Dish name="Salade de patates douces" description="rôties au miel, nectarine fraîche et fromage frais" tags={['sg', 'vege']} />
        </div>
        <p class="dishes__legend">SG : sans gluten. Végé : végétarien.</p>
      </div>
      <Button href={site.zenchef.table} external variant="primary" class="carte__cta">Réserver une table</Button>
    </div>
  </section>

  <SectionStub id="bar" name="Le bar" />
  <SectionStub id="lieu" name="Le lieu" />

  <section id="infos" class="wrap section">
    <SectionHeader title="Infos pratiques" />
    <div class="cards" style="--min: 280px">
      <Card>
        <span class="label">Horaires</span>
        <p>{site.hours.long}</p>
        <p>Les soirs et week-ends sont dédiés aux privatisations.</p>
      </Card>
      <Card>
        <span class="label">Réservation</span>
        <p>En ligne ou par téléphone.</p>
        <div class="actions">
          <Button href={`tel:${phones.restaurant.tel}`}>{phones.restaurant.display}</Button>
        </div>
      </Card>
      <Card>
        <span class="label">Adresse</span>
        <p>{site.address.street}<br />{site.address.city}</p>
        <p>Métro A Balma-Gramont, parking gratuit.</p>
      </Card>
    </div>
    <div class="infos__faq">
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .carte {
    background: var(--paper);
    border-block: var(--line);
  }

  .dishes {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
    margin-top: 56px;
  }

  .dishes__title {
    font-size: clamp(32px, 3.4vw, 44px);
  }

  .dishes__legend {
    font-size: 13px;
  }

  .carte :global(.carte__cta) {
    margin-top: 24px;
  }

  .infos__faq {
    margin-top: 56px;
  }
</style>
