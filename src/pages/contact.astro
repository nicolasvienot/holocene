---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Field from '../components/forms/Field.astro';
import Hero from '../components/Hero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { phones, site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact et devis"
  description="Une table, une soirée privée, un mariage, un festival : dites-nous ce qui vous amène, on vous oriente vers la bonne personne."
>
  <Hero
    accent="Salut"
    size="xl"
    title={['On vous', 'écoute.']}
    text="Une table, une soirée privée, un mariage, un festival ? Dites-nous ce qui vous amène, on vous oriente vers la bonne personne."
  />

  <section class="wrap contact">
    <Card tone="light" highlight>
      <form class="form" aria-label="Formulaire de contact (bientôt disponible)">
        <div class="form__grid">
          <Field label="Nom complet" name="nom" placeholder="Camille Durand" autocomplete="name" />
          <Field label="E-mail" name="email" type="email" placeholder="camille@exemple.fr" autocomplete="email" />
          <Field label="Téléphone" name="telephone" type="tel" placeholder="06 00 00 00 00" autocomplete="tel" />
          <Field label="Date souhaitée" name="date" type="date" />
        </div>
        <Field label="Message" name="message" type="textarea" placeholder="Type d'événement, lieu, nombre d'invités, budget…" />
        <p class="form__note">Vos données servent uniquement à vous répondre.</p>
        <p class="form__note">[Formulaire non branché : envoi à venir. En attendant, appelez ou écrivez-nous.]</p>
        <div class="actions">
          <Button type="submit" variant="primary" disabled>Envoyer</Button>
        </div>
      </form>
    </Card>

    <div class="details">
      <Card tone="dark">
        <span class="label details__kicker">Traiteur et food truck</span>
        <a href={`tel:${phones.traiteur.tel}`} class="display details__phone">{phones.traiteur.display}</a>
        <a href={`mailto:${site.email}`} class="details__link">{site.email}</a>
      </Card>
      <Card>
        <span class="label">Restaurant</span>
        <a href={`tel:${phones.restaurant.tel}`} class="display details__phone">{phones.restaurant.display}</a>
        <p>{site.hours.long}</p>
      </Card>
      <Card>
        <span class="label">Adresse</span>
        <p>{site.address.street}<br />{site.address.city}</p>
        <div class="actions">
          <Button href={site.address.mapsUrl} external>Itinéraire</Button>
        </div>
      </Card>
      <Card>
        <span class="label">Nous suivre</span>
        <SocialLinks />
      </Card>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 24px;
    align-items: start;
    padding-bottom: var(--section-y);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 20px;
  }

  .form__note {
    font-size: 13px;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .details__kicker {
    color: var(--pink);
  }

  .details__phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-size: clamp(30px, 3.2vw, 44px);
    text-decoration: none;
  }

  .details__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    color: inherit;
    overflow-wrap: anywhere;
  }
</style>
