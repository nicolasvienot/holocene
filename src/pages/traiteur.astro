---
import Base from '../layouts/Base.astro';
import Accent from '../components/Accent.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import FormatList from '../components/FormatList.astro';
import HeroFacts from '../components/HeroFacts.astro';
import IncludedGrid from '../components/IncludedGrid.astro';
import Kicker from '../components/Kicker.astro';
import PhoneCard from '../components/PhoneCard.astro';
import Pill from '../components/Pill.astro';
import References from '../components/References.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Steps from '../components/Steps.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import DemandeForm from '../components/forms/DemandeForm.astro';
import infos from '../data/infos.json';
import data from '../data/traiteur.json';
import { faqJsonLd, traiteurJsonLd } from '../lib/seo';

const { heroFacts, pourQui, formats, avantGout, cleEnMain, etapes, temoignage, formulaireDevis, faq } = data;
---
<Base
  capsule="traiteur"
  title="Traiteur à Toulouse pour mariages et entreprises - Holocene"
  description="Traiteur à Toulouse et en Occitanie : cocktails, repas assis, mariages et plateaux-repas, de 40 à 1500 invités. Produits frais en direct, service clé en main."
  jsonLd={[traiteurJsonLd('Holocene Traiteur', '/traiteur'), faqJsonLd(faq)]}
>
  <section class="wrap hero">
    <div class="ag hero-grille">
      <div class="pile pile-start hero-texte">
        <Accent texte="Sur mesure" class="hero-accent" />
        <h1 class="d hero-titre">Votre<br />événement.<br />Notre<br />cuisine.</h1>
        <p class="p t20">Traiteur à Toulouse et partout en Occitanie. Des produits frais achetés en direct aux producteurs, des menus qui suivent les saisons, et une équipe qui s'occupe de tout — de 40 à 1500 invités.</p>
        <div class="rang">
          <Button variant="dark" href="#devis" label="Demander un devis" />
          <Button variant="flower" href="#formats" label="Voir les menus" />
        </div>
        <HeroFacts faits={heroFacts} />
      </div>
      <div class="hero-visuel">
        <img
          src="/images/verrines-peas.jpg"
          alt="Bouchées petits pois, tuiles croustillantes et foie gras sur pain de campagne, en buffet cocktail"
          width="960"
          height="980"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section id="pourqui" class="fond-blanc trait-haut trait-bas">
    <div class="wrap section-112">
      <SectionHeader titre={['Pour qui on cuisine']} texte="Deux savoir-faire, une même exigence : la cuisine d'un chef formé en maison étoilée, servie à l'échelle de votre événement." />
      <div class="ag pourqui">
        {pourQui.map((p) => (
          <div class:list={['public', { 'public--avant': p.miseEnAvant }]} style={`background:var(${p.fond})`}>
            <div class="public-tete">
              <h3 class="d">{p.titre}</h3>
              <Pill texte={p.zonePill} fond="var(--paper)" />
            </div>
            <ul>
              {p.items.map((item) => <li>{item}</li>)}
            </ul>
            <p>{p.zone}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="formats" class="wrap section-112">
    <SectionHeader titre={['Formats', '& menus']} texte="Nos menus changent avec les saisons. Téléchargez celui qui correspond à votre format : on l'adapte ensuite à votre thème, votre budget et vos invités." largeur={440} />
    <FormatList formats={formats} />
    <p class="avant-gout"><Kicker texte="Un avant-goût" class="avant-gout-k" />{avantGout}</p>
  </section>

  <section id="service" class="sur-noir">
    <div class="wrap section-112 service">
      <SectionHeader kicker="Clé en main" titre={["On s'occupe", 'de tout.']} texte="Un seul interlocuteur, du premier appel au dernier verre. Tout ce qui suit est compris dans nos prestations, ajusté à votre format." marge={56} />
      <IncludedGrid elements={cleEnMain} photo="/images/verrines-jars.jpg" alt="Verrines de gaspacho surmontées de stracciatella, en buffet" />
      <Steps etapes={etapes} />
    </div>
  </section>

  <section id="references" class="wrap section-112">
    <div class="ag refs-grille">
      <div class="pile refs-gauche">
        <h2 class="d t76">Ils nous ont fait confiance</h2>
        <References page="traiteur" troisColonnes />
      </div>
      <TestimonialCard texte={temoignage.texte} auteur={temoignage.auteur} icone="/brand/icon-traiteur.svg" />
    </div>
  </section>

  <section id="devis" class="fond-blanc trait-haut">
    <div class="wrap section-112 devg">
      <div class="pile dintro">
        <Kicker texte="Demande de devis" />
        <h2 class="d t76">Parlons de votre événement.</h2>
        <p class="p">Date, lieu, nombre d'invités, envies : on vous répond avec une proposition chiffrée et un menu sur mesure.</p>
        <PhoneCard label="Ligne traiteur & food truck" telephone={infos.telephones.traiteurFoodTruck} />
      </div>
      <div class="pile dfaq">
        <h3 class="d">Questions fréquentes</h3>
        <Faq questions={faq} compact />
      </div>
      <DemandeForm id="devis-form" destination="traiteur" champs={formulaireDevis.champs} bouton={formulaireDevis.bouton} colonne={220} class="dform" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 40px; padding-bottom: 112px; }
  .hero-grille { --min: 540px; --gap: 56px; align-items: center; }
  .hero-texte { --gap: 30px; }
  .hero-texte :global(.hero-accent) { font-size: 30px; }
  .hero-titre { font-size: clamp(52px, 5.8vw, 84px); }
  .hero-texte .p { max-width: 540px; }
  .hero-visuel { padding: 0 10px 10px 0; }
  .hero-visuel img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border: var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-hero);
  }
  @media (max-width: 420px) {
    .hero-titre { font-size: clamp(40px, 14.5vw, 60px); }
  }

  .pourqui { --min: 460px; }
  .public { display: flex; flex-direction: column; gap: 24px; padding: 40px; border: var(--line); border-radius: 36px; }
  .public--avant { box-shadow: var(--shadow-hero); }
  .public-tete { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .public-tete h3 { font-size: 52px; }
  .public li { padding: 12px 0; border-bottom: var(--line-dashed); font-size: 16px; line-height: 1.45; }
  .public li:last-child { border-bottom: 0; }
  .public > p { font-size: 14px; line-height: 1.6; }

  @media (max-width: 480px) {
    .public-tete h3 { font-size: clamp(30px, calc(18.5vw - 29px), 43px); }
  }

  .avant-gout { margin-top: 24px; font-size: 15px; line-height: 1.6; }
  .avant-gout :global(.avant-gout-k) { font-size: 10px; margin-right: 12px; }

  .service { --sh-k: var(--flower); }

  .refs-grille { --min: 460px; --gap: 56px; align-items: start; }
  .refs-gauche { --gap: 28px; }

  .devg {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: 'intro form' 'faq form';
    gap: 48px 64px;
    align-items: start;
  }
  .dintro { grid-area: intro; --gap: 26px; }
  .dfaq { grid-area: faq; --gap: 20px; }
  .dfaq h3 { font-size: 32px; }
  .devg :global(.dform) { grid-area: form; }

  @media (max-width: 980px) {
    .devg {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: 'intro' 'form' 'faq';
    }
  }
</style>
