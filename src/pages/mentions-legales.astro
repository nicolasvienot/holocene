---
import Hero from '../components/Hero.astro';
import { phones, site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="Mentions légales" description="Mentions légales du site Holocene Food Event.">
  <Hero size="md" title="Mentions légales" />

  <section class="wrap legal">
    <div>
      <h2 class="display">Éditeur du site</h2>
      <p>Holocene Food Event - [Forme juridique et capital social]</p>
      <p>{site.address.street}, {site.address.city}</p>
      <p>[SIRET] - [RCS] - [Numéro de TVA]</p>
      <p>
        Téléphone : <a href={`tel:${phones.restaurant.tel}`}>{phones.restaurant.display}</a> (restaurant),
        <a href={`tel:${phones.traiteur.tel}`}>{phones.traiteur.display}</a> (traiteur et food truck)
      </p>
      <p>E-mail : <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div>
      <h2 class="display">Publication</h2>
      <p>Directeur de la publication : [Nom]</p>
    </div>
    <div>
      <h2 class="display">Hébergement</h2>
      <p>[Nom, adresse et téléphone de l'hébergeur]</p>
    </div>
    <div>
      <h2 class="display">Données personnelles</h2>
      <p>[Politique de confidentialité à fournir : responsable du traitement, durée de conservation, droits des personnes]</p>
    </div>
    <div>
      <h2 class="display">Cookies</h2>
      <p>[À compléter selon les services intégrés au site]</p>
    </div>
    <div>
      <h2 class="display">Crédits</h2>
      <p>[Crédits photo à compléter]</p>
      <p>Charte graphique by MOM'S.</p>
    </div>
  </section>
</Base>

<style>
  .legal {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-bottom: var(--section-y);
  }

  .legal > div {
    max-width: 760px;
  }

  .legal h2 {
    margin-bottom: 18px;
    font-size: clamp(28px, 3vw, 40px);
  }

  .legal p + p {
    margin-top: 6px;
  }
</style>
