---
import Accent from '../components/Accent.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Chip from '../components/Chip.astro';
import Dish from '../components/Dish.astro';
import Faq from '../components/Faq.astro';
import Field from '../components/forms/Field.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Pill from '../components/Pill.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Tag from '../components/Tag.astro';
import { univers, universOrder, type UniversId } from '../data/univers';
import Base from '../layouts/Base.astro';

const allUnivers = universOrder.map((id: UniversId) => univers[id]);

const toc = [
  ['couleurs', 'Couleurs'],
  ['typo', 'Typographie'],
  ['formes', 'Formes'],
  ['logos', 'Logos'],
  ['boutons', 'Boutons'],
  ['navigation', 'Navigation'],
  ['pastilles', 'Pastilles'],
  ['cartes', 'Cartes'],
  ['listes', 'Listes'],
  ['formulaires', 'Formulaires'],
  ['sections', 'Sections'],
  ['regles', 'Règles'],
];

const buttonVariants = [
  { variant: 'primary', name: 'Principal' },
  { variant: 'secondary', name: 'Secondaire' },
  { variant: 'flower', name: 'Couleur' },
] as const;
const pillTones = ['outline', 'white', 'flower', 'dark'] as const;
const cardTones = ['paper', 'bg', 'flower', 'light', 'dark'] as const;
const currentPaths: Record<UniversId, string> = {
  holocene: '/equipe',
  'food-truck': '/food-truck',
  traiteur: '/traiteur',
  restaurant: '/restaurant/privatiser',
};
const faqItems = [
  { question: 'Faut-il réserver ?', answer: "C'est conseillé, surtout en fin de semaine." },
  { question: "Ouvrez-vous le soir et le week-end ?", answer: 'Le service régulier a lieu en semaine, le midi. Les soirs et week-ends, le lieu se privatise pour vos événements.' },
];
const rules = [
  'Une seule action principale, en noir, par écran.',
  'Une seule carte à 10 px par groupe.',
  'Deux autocollants maximum par visuel, jamais sur du texte.',
  'Un seul bandeau défilant par page.',
  'Texte noir sur pastel, blanc uniquement sur noir.',
  'Pas de dégradé, pas de rouge ou de vert système, pas d’ombre floue, pas d’émoji.',
  'Titres en capitales Nimbus, sans ? ! : / + % ni tiret long.',
  'Vividly : une seule ligne courte, avec les lettres autorisées uniquement.',
];
---

<Base title="Design system" description="Recette visuelle interne des composants Holocene." noindex>
  <div class="wrap ds">
    <SectionHeader level={1} label="Interne" title="Design system">
      Les composants réels du site, avec leurs variantes et leurs états, dans les 4 univers. Les états survol, focus
      et clic sont forcés pour pouvoir les comparer ; les autres réagissent normalement.
    </SectionHeader>

    <nav aria-label="Sommaire du design system">
      <ol class="toc">
        {toc.map(([id, name], index) => <li><a href={`#${id}`}>{String(index + 1).padStart(2, '0')} {name}</a></li>)}
      </ol>
    </nav>

    <section id="couleurs" class="ds__section">
      <h2 class="display ds__title">01. Couleurs</h2>
      <div class="ds__grid4">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <div class="swatches">
                <div class="swatch swatch--bg"><span>Fond</span><span>{u.colors.bg}</span></div>
                <div class="swatch swatch--flower"><span>Fleur</span><span>{u.colors.flower}</span></div>
                <div class="swatch swatch--light"><span>Clair</span><span>{u.colors.light}</span></div>
                <div class="swatch swatch--ink"><span>Encre</span><span>#000000</span></div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="typo" class="ds__section">
      <h2 class="display ds__title">02. Typographie</h2>
      <div class="panel" data-univers="holocene">
        <p class="display type-display">Display</p>
        <p class="display type-h2">Titre H2</p>
        <p class="display type-h3">Titre H3</p>
        <span class="label">Label Nimbus 12 px</span>
        <Accent text="Great food inside" size="lg" />
        <Accent text="Great food inside" />
        <Accent text="Great food inside" size="sm" />
        <p class="type-intro">Texte d'intro, 20 px. Un restaurant, un traiteur, un food truck.</p>
        <p>Texte courant, 18 px, interligne 1,6. Une carte qui change chaque mois, des suggestions chaque semaine.</p>
        <p class="type-small">Petit texte, 13 à 15 px. Vos données servent uniquement à vous répondre.</p>
      </div>
    </section>

    <section id="formes" class="ds__section">
      <h2 class="display ds__title">03. Formes</h2>
      <div class="ds__grid3">
        <div class="panel" data-univers="holocene">
          <span class="label">Rayons</span>
          <div class="shapes">
            <div class="shape" style="border-radius: var(--radius-field)">18</div>
            <div class="shape" style="border-radius: var(--radius-sm)">24</div>
            <div class="shape" style="border-radius: var(--radius-card)">32</div>
            <div class="shape" style="border-radius: var(--radius-block)">40</div>
            <div class="shape" style="border-radius: var(--radius-pill)">999</div>
          </div>
        </div>
        <div class="panel" data-univers="holocene">
          <span class="label">Traits</span>
          <div class="stroke" style="border-top: var(--line)">2 px plein : contours</div>
          <div class="stroke" style="border-top: var(--line-dashed)">1,5 px tirets : entre les plats</div>
          <div class="stroke stroke--dark" data-on-dark>1 px sur noir</div>
        </div>
        <div class="panel" data-univers="holocene">
          <span class="label">Ombres pleines</span>
          <div class="shapes">
            <div class="shape" style="box-shadow: var(--shadow-btn)">4</div>
            <div class="shape" style="box-shadow: var(--shadow-hover)">6</div>
            <div class="shape" style="box-shadow: var(--shadow-hero)">10</div>
          </div>
        </div>
      </div>
    </section>

    <section id="logos" class="ds__section">
      <h2 class="display ds__title">04. Logos et icônes</h2>
      <div class="ds__grid4">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <img class="logo-sample" src={u.logo} alt={u.fullName} width="1470" height="378" loading="lazy" />
              <img class="icon-sample" src={u.icon} alt="" width="139" height="278" loading="lazy" />
            </div>
          ))
        }
      </div>
      <div class="ds__grid3 ds__mt">
        <div class="panel panel--dark" data-on-dark>
          <span class="label">Version blanche, sur noir</span>
          <img class="logo-sample" src="/brand/logo-holocene-food-event-white.svg" alt="Holocene Food.Event" width="1470" height="378" loading="lazy" />
          <img class="icon-sample" src="/brand/icon-white.svg" alt="" width="139" height="278" loading="lazy" />
        </div>
        <div class="panel" data-univers="holocene">
          <span class="label">Empilé</span>
          <img class="logo-sample" src="/brand/logo-holocene-stack.svg" alt="Holocene" width="737" height="368" loading="lazy" />
        </div>
        <div class="panel" data-univers="holocene">
          <span class="label">Vertical</span>
          <img class="logo-sample" src="/brand/logo-holocene-vertical.svg" alt="Holocene" width="1272" height="688" loading="lazy" />
        </div>
      </div>
    </section>

    <section id="boutons" class="ds__section">
      <h2 class="display ds__title">05. Boutons</h2>
      <div class="ds__stack">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              {buttonVariants.map(({ variant, name }) => (
                <div class="row">
                  <span class="row__name">{name}</span>
                  <Button variant={variant}>Repos</Button>
                  <Button variant={variant} state="hover">Survol</Button>
                  <Button variant={variant} state="focus">Focus</Button>
                  {variant === 'primary' && <Button variant={variant} state="active">Clic</Button>}
                  <Button variant={variant} disabled>Désactivé</Button>
                  <Button variant={variant} size="sm">Compact</Button>
                  <Button variant={variant} icon="arrow">Avec icône</Button>
                </div>
              ))}
              <div class="panel panel--dark panel--inner" data-on-dark>
                <span class="label">Sur fond noir</span>
                <div class="row">
                  <Button variant="onDark">Repos</Button>
                  <Button variant="onDark" state="hover">Survol</Button>
                  <Button variant="onDark" state="focus">Focus</Button>
                  <Button variant="onDark" disabled>Désactivé</Button>
                  <Button variant="flower">Couleur</Button>
                  <Button variant="flower" state="hover">Survol</Button>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="navigation" class="ds__section">
      <h2 class="display ds__title">06. Navigation</h2>
      <p class="ds__note">
        La capsule, dans chaque univers. Passez sur les liens et les pastilles pour voir le soulignement et les bulles.
        Le menu compact apparaît quand la capsule fait moins de 1224 px (soit un écran de moins de 1320 px).
      </p>
      <div class="ds__stack">
        {
          allUnivers.map((u) => (
            <div class="panel panel--capsule" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <Header univers={u.id} currentPath={currentPaths[u.id]} />
            </div>
          ))
        }
      </div>
      <h3 class="display ds__subtitle">Menu compact</h3>
      <div class="ds__grid4 ds__grid4--menus">
        {
          allUnivers.map((u) => (
            <div class="panel panel--menu" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <Header univers={u.id} currentPath={currentPaths[u.id]} menuOpen />
            </div>
          ))
        }
      </div>
      <h3 class="display ds__subtitle">Réseaux</h3>
      <div class="ds__grid3">
        <div class="panel" data-univers="holocene"><span class="label">Sur clair</span><SocialLinks /></div>
        <div class="panel panel--dark" data-on-dark><span class="label">Sur noir</span><SocialLinks onDark /></div>
      </div>
      <p class="ds__note ds__mt">Le pied de page, avec l'illustration de Toulouse, est visible en bas de cette page.</p>
    </section>

    <section id="pastilles" class="ds__section">
      <h2 class="display ds__title">07. Pastilles</h2>
      <div class="ds__grid2">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <div class="row">{pillTones.map((tone) => <Pill tone={tone}>{tone === 'outline' ? 'Contour' : tone === 'white' ? 'Blanche' : tone === 'flower' ? 'Fleur' : 'Noire'}</Pill>)}</div>
              <div class="row"><Pill tone="white" size="lg">Grande</Pill></div>
              <div class="row"><Tag>Contour</Tag><Tag tone="white">SG</Tag><Tag tone="flower">Végé</Tag><Tag>+1 €</Tag><Tag tone="white">Le plus pris</Tag></div>
              <div class="row">
                <Chip active>Active</Chip>
                <Chip>Repos</Chip>
                <Chip state="hover">Survol</Chip>
                <Chip state="focus">Focus</Chip>
              </div>
              <PhotoSlot label="Autocollants" univers={u.id}>
                <Pill tone="white" sticker={-8}>Frais</Pill>
                <Pill tone="flower" sticker={6}>Local</Pill>
              </PhotoSlot>
            </div>
          ))
        }
      </div>
    </section>

    <section id="cartes" class="ds__section">
      <h2 class="display ds__title">08. Cartes</h2>
      <div class="ds__stack">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>

              <h3 class="ds__label">Tons</h3>
              <div class="cards" style="--min: 200px">
                {cardTones.map((tone) => <Card tone={tone}><span class="label">{tone}</span><p>Trait 2 px, rayon 32.</p></Card>)}
              </div>
              <div class="cards" style="--min: 280px">
                <Card highlight><span class="label">Mise en avant</span><p>Ombre 10 px.</p></Card>
                <Card href={u.home}><span class="label">Carte-lien</span><p>Toute la carte est cliquable.</p></Card>
              </div>

              <h3 class="ds__label">Prix</h3>
              <div class="cards" style="--min: 240px">
                <PriceCard label="Plat" price="17€" />
                <PriceCard label="Entrée - plat ou plat - dessert" price="20,50€" />
                <PriceCard label="Entrée - plat - dessert" price="24€" highlight badge="Le plus pris" />
              </div>

              <h3 class="ds__label">Compositions</h3>
              <div class="cards compos" style="--min: 280px">
                <Card tone="bg" href={u.home} class="compo-univers">
                  <div class="compo-between">
                    <span class="display compo-number">02</span>
                    <Pill tone="white">Sur mesure</Pill>
                  </div>
                  <img class="compo-icon" src={u.icon} alt="" width="75" height="150" loading="lazy" />
                  <img class="compo-logo" src={u.logo} alt={u.fullName} width="1470" height="378" loading="lazy" />
                  <p class="compo-text">Une phrase qui dit ce qu'on y trouve.</p>
                  <Button decorative>Découvrir</Button>
                </Card>
                <Card>
                  <Accent text="Local" size="lg" />
                  <p class="compo-text">En direct avec les producteurs d'Occitanie, sans intermédiaire.</p>
                </Card>
                <Card tone="dark">
                  <Accent text="Sur mesure" size="lg" />
                  <p class="compo-text">Variante noire : la dernière de la rangée, pour clore.</p>
                </Card>
                <Card tone="flower">
                  <span class="display compo-step">02</span>
                  <h4 class="display compo-h">Le jour J</h4>
                  <p class="compo-text">Installation, cuisine sur place, service tout au long de l'événement.</p>
                </Card>
                <Card flush>
                  <PhotoSlot label="Portrait" univers={u.id} tone="bg" flush />
                  <div class="compo-person">
                    <Pill tone="flower">Pôle cuisine</Pill>
                    <h4 class="display compo-h">Julien Sanchez</h4>
                    <p class="compo-text">Le chef, passé par L'Allée des Vignes à Cajarc.</p>
                  </div>
                </Card>
                <Card tone="bg">
                  <div class="compo-between">
                    <Pill tone="white">Traiteur</Pill>
                    <span class="label">[DATE]</span>
                  </div>
                  <p class="compo-post">Comment organiser un cocktail dînatoire professionnel ?</p>
                  <span class="label">Lire</span>
                </Card>
                <Card>
                  <div class="compo-between">
                    <h4 class="display compo-h">La salle</h4>
                    <Pill>Béton, bois</Pill>
                  </div>
                  <dl class="compo-figures">
                    <div><dt class="label">Cocktail</dt><dd class="display compo-figure">110</dd></div>
                    <div><dt class="label">Assis</dt><dd class="display compo-figure">75</dd></div>
                  </dl>
                </Card>
                <Card highlight>
                  <img class="compo-quote-icon" src={u.icon} alt="" width="30" height="60" loading="lazy" />
                  <figure class="compo-quote">
                    <blockquote>« [Avis client réel, avec prénom et événement.] »</blockquote>
                    <figcaption class="label">[Prénom - mariage - 2026]</figcaption>
                  </figure>
                </Card>
                <div class="compo-phone">
                  <span class="label">Plutôt par téléphone</span>
                  <a class="display compo-h" href={`tel:${u.phone.tel}`}>{u.phone.display}</a>
                </div>
              </div>

              <div class="compo-banner">
                <div class="compo-banner__text">
                  <Accent text="Soirs et fins de semaine" size="sm" />
                  <h4 class="display compo-banner__title">Privatisez Holocene.</h4>
                </div>
                <Button variant="primary">Découvrir</Button>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="listes" class="ds__section">
      <h2 class="display ds__title">09. Listes</h2>
      <div class="ds__grid2">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <div>
                <Dish name="Tartare de poisson" description="pomme Granny, aneth, concombre, jus vert et moutarde nori" tags={['sg']} supplement={1} />
                <Dish name="Salade de patates douces" description="rôties au miel, nectarine fraîche et fromage frais" tags={['sg', 'vege']} />
                <Dish name="Suggestion du jour" description="à découvrir sur l'ardoise" />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="formulaires" class="ds__section">
      <h2 class="display ds__title">10. Formulaires</h2>
      <div class="ds__grid2">
        {
          allUnivers.map((u) => (
            <div class="panel" data-univers={u.id}>
              <span class="label">{u.name}</span>
              <Card tone="light" highlight>
                <div class="fields">
                  <Field label="Repos" name="repos" id={`${u.id}-repos`} placeholder="Camille Durand" />
                  <Field label="Focus" name="focus" id={`${u.id}-focus`} state="focus" placeholder="camille@exemple.fr" />
                  <Field label="Erreur" name="erreur" id={`${u.id}-erreur`} type="email" error="Adresse e-mail incomplète" />
                  <Field label="Désactivé" name="desactive" id={`${u.id}-desactive`} placeholder="Non modifiable" disabled />
                  <Field label="Liste" name="liste" id={`${u.id}-liste`} type="select" options={['La salle', 'La terrasse']} />
                  <Field label="Date" name="date" id={`${u.id}-date`} type="date" />
                </div>
                <Field label="Zone de texte" name="message" id={`${u.id}-message`} type="textarea" placeholder="Type d'événement, horaires, ambiance…" />
                <p class="type-small">Vos données servent uniquement à vous répondre.</p>
              </Card>
            </div>
          ))
        }
      </div>
    </section>

    <section id="sections" class="ds__section">
      <h2 class="display ds__title">11. Sections</h2>
      <div class="ds__stack">
        {
          allUnivers.map((u) => (
            <div class="panel panel--flush" data-univers={u.id}>
              <span class="label panel__label">{u.name}</span>
              <Hero level={3} size="sm" accent="Great food inside" title={['Un héros.']} text="Accent, titre, phrase, un ou deux boutons, visuel à droite avec une ombre de 10 px.">
                <Fragment slot="actions">
                  <Button variant="primary">Action principale</Button>
                  <Button variant="flower">Secondaire</Button>
                </Fragment>
                <PhotoSlot slot="visual" label="Visuel" univers={u.id} highlight>
                  <Pill tone="white" sticker={-8}>Frais</Pill>
                  <Pill tone="white" sticker={6}>Local</Pill>
                </PhotoSlot>
              </Hero>
              <Marquee items={['Fait maison', 'De saison', 'Local']} />
              <Marquee items={['Fait maison', 'De saison', 'Local']} tone="flower" />
              <div class="wrap section">
                <SectionHeader level={3} label="Label" title={['Titre', 'de section']}>
                  Titre à gauche, texte à droite.
                </SectionHeader>
                <Faq items={faqItems} />
              </div>
            </div>
          ))
        }
        <div class="panel panel--flush" data-univers="restaurant">
          <span class="label panel__label">Héros noir (Privatiser)</span>
          <Hero level={3} dark size="sm" accent="Soirs et fins de semaine" title="Un héros noir." text="La capsule reste blanche au-dessus.">
            <Fragment slot="actions">
              <Button variant="flower">Couleur</Button>
              <Button variant="onDark">Sur noir</Button>
            </Fragment>
            <PhotoSlot slot="visual" label="Visuel" univers="restaurant" tone="dark" />
          </Hero>
        </div>
      </div>
    </section>

    <section id="regles" class="ds__section">
      <h2 class="display ds__title">12. Règles</h2>
      <ul class="rules">
        {rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .ds {
    padding-block: 40px var(--section-y);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px 0 calc(14px + 0.12em);
    border: var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .toc a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .ds__section {
    margin-top: var(--section-y);
    padding-top: 40px;
    border-top: var(--line);
    scroll-margin-top: 16px;
  }

  .ds__title {
    margin-bottom: 40px;
    font-size: clamp(42px, 6vw, 88px);
  }

  .ds__subtitle {
    margin-block: 48px 24px;
    font-size: clamp(30px, 3.4vw, 44px);
  }

  .ds__label {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ds__note {
    max-width: 720px;
    margin-bottom: 32px;
    font-size: 15px;
  }

  .ds__mt {
    margin-top: 24px;
  }

  .ds__stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ds__grid2,
  .ds__grid3,
  .ds__grid4 {
    display: grid;
    gap: 24px;
  }

  .ds__grid2 {
    grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr));
  }

  .ds__grid3 {
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }

  .ds__grid4 {
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    padding: 32px;
    border: var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .panel--dark {
    background: var(--ink);
    color: var(--paper);
  }

  .panel--flush {
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .panel__label {
    padding: 32px var(--gutter) 0;
  }

  /* Pleine largeur : sous 1224 px de large, la capsule passerait en menu compact. */
  .panel--capsule {
    gap: 8px;
    padding: 20px 0 44px;
    border: 0;
    border-radius: 0;
  }

  /* Laisse la place à la carte menu ouverte, qui sort de la capsule. */
  .panel--menu {
    min-height: 960px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
