---
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import Pill from '../components/Pill.astro';
import type { UniversId } from '../data/univers';
import Base from '../layouts/Base.astro';

const articles: { theme: string; univers: UniversId; date: string; title: string; text: string }[] = [
  {
    theme: 'Traiteur',
    univers: 'traiteur',
    date: '22.05.2025',
    title: 'Comment organiser un cocktail dînatoire professionnel avec un traiteur ?',
    text: "Budget, nombre de pièces par personne, timing, boissons : le pas-à-pas pour un cocktail réussi, sans stress pour l'organisateur.",
  },
  {
    theme: 'Traiteur',
    univers: 'traiteur',
    date: '[DATE]',
    title: 'Comment choisir le meilleur traiteur pour son événement professionnel à Toulouse ?',
    text: 'Les questions à poser, les signaux qui rassurent, et ce qui fait la différence le jour J.',
  },
  {
    theme: 'Mariage',
    univers: 'holocene',
    date: '[DATE]',
    title: 'Traiteur mariage à Toulouse : ce qu’on prépare pour le plus beau jour',
    text: 'Vin d’honneur, dîner, bar de nuit, brunch du lendemain : la journée vue de nos cuisines.',
  },
  {
    theme: 'Restaurant',
    univers: 'restaurant',
    date: '[DATE]',
    title: 'Holocene ouvre les portes de son restaurant',
    text: 'Après le food truck et le traiteur, une adresse à Balma pour manger chez nous, le midi.',
  },
  {
    theme: 'Manger local',
    univers: 'food-truck',
    date: '[DATE]',
    title: '10 bonnes raisons de manger local',
    text: 'Goût, saisons, producteurs, planète : pourquoi on achète tout en Occitanie, ou presque.',
  },
];
---

<Base
  title="Le journal"
  description="Les actus de la maison, nos conseils pour réussir vos événements et quelques bonnes raisons de manger local."
>
  <Hero
    accent="Recettes et coulisses"
    size="xl"
    title="Le journal"
    text="Les actus de la maison, nos conseils pour réussir vos événements et quelques bonnes raisons de manger local."
  />

  <section class="wrap list">
    <ul class="cards" style="--min: 380px">
      {
        articles.map((article) => (
          <li>
            <Card tone="bg" data-univers={article.univers} class="article">
              <div class="article__meta">
                <Pill tone="white">{article.theme}</Pill>
                <span class="label">{article.date}</span>
              </div>
              <h2 class="article__title">{article.title}</h2>
              <p class="article__text">{article.text}</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .list {
    padding-bottom: var(--section-y);
  }

  .cards li {
    display: flex;
  }

  .cards :global(.article) {
    width: 100%;
    min-height: 340px;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .article__title {
    margin-top: auto;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.22;
    text-wrap: pretty;
  }

  .article__text {
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .cards :global(.article) {
      min-height: 0;
    }

    .article__title {
      margin-top: 0;
      font-size: 24px;
    }
  }
</style>
